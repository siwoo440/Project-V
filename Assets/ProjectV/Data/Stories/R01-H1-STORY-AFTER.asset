  m_Script: {fileID: 11500000, guid: 9a4e1c7d3b6f42a8b0d5e2f7c1a38d46, type: 3}
  m_Name: R01-H1-STORY-AFTER
  m_EditorClassIdentifier: Assembly-CSharp::StorySceneData
  sceneId: R01-H1-STORY-AFTER
  title: '물러서지 않는 기사'
  lines:
  - speakerName: ''
    text: '아리아가 한 걸음 물러섰다. 검끝은 아직 도윤을 향해 있다.'
    speakerSlot: 0
    leftArt: 'Doyoon'
    centerArt: 'Grimoire'
    rightArt: 'Aria:Hit'
    backgroundKey: 'Region01_Battle_BG_01'
    branch: ''
    choices: []
  - speakerName: '아리아'
    text: '한 번 밀렸을 뿐이다. 이것으로 너를 인정한 것은 아니다.'
    speakerSlot: 3
    leftArt: ''
    centerArt: ''
    rightArt: ''
    backgroundKey: ''
    branch: ''
    choices: []
  - speakerName: '도윤'
    text: '그래도 길은 열어 주는 거지?'
    speakerSlot: 1
    leftArt: 'Doyoon:Smile'
    centerArt: ''
    rightArt: ''
    backgroundKey: ''
    branch: ''
    choices: []
  - speakerName: '아리아'
    text: '숲 안쪽의 마물들을 상대해 봐라. 네 마물이 숲을 해치지 않는지 지켜보겠다.'
    speakerSlot: 3
    leftArt: ''
    centerArt: ''
    rightArt: 'Aria'
    backgroundKey: ''
    branch: ''
    choices: []
  - speakerName: '그리모어'
    text: '숲 안쪽부터 정리하라는 소리네. 가자, 계약자.'
    speakerSlot: 2
    leftArt: ''
    centerArt: 'Grimoire:Smile'
    rightArt: ''
    backgroundKey: ''
    branch: ''
    choices: []
